    {"id": "msg0342", "date": "2021-09-24", "time": "00:43", "sender": "선우", "text": "근데 자기 전에 다른 노래 들으면", "trans": "可是睡前聽別的歌的話"},
    {"id": "msg0343", "date": "2021-09-24", "time": "00:43", "sender": "선우", "text": "머릿속에 그 노래 맴돌아서 잠 안 와", "trans": "那首歌會一直在腦中打轉，讓我睡不著"},
    {"id": "msg0344", "date": "2021-09-24", "time": "00:43", "sender": "선우", "text": "그러니까 나를 듣자", "trans": "所以來聽我吧"},
