    {"id": "msg0327", "date": "2021-09-24", "time": "00:27", "sender": "선우", "text": "응 여기있지", "trans": "嗯，我在這裡"},
    {"id": "msg0328", "date": "2021-09-24", "time": "00:27", "sender": "선우", "text": "우리 bex 누나 인나쒀여?", "trans": "我們 bex 姊姊起床了嗎？"},
