    {"id": "msg0203", "date": "2021-10-25", "time": "14:26", "sender": "선우", "text": "까보면 알겠지 뭐!", "trans": "公開後就知道了嘛！"},
    {"id": "msg0204", "date": "2021-10-25", "time": "14:26", "sender": "선우", "text": "말 해주고 싶지만 그러지 못해서 미안해", "trans": "很想告訴你，但不能這麼做，對不起"},
    {"id": "msg0205", "date": "2021-10-25", "time": "14:29", "sender": "선우", "text": "오늘은 뭐 뜨나?", "trans": "今天會公開什麼呢？"},
    {"id": "msg0206", "date": "2021-10-25", "time": "14:29", "sender": "선우", "text": "아는 거 있어?", "trans": "你有知道的嗎？"},
    {"id": "msg0207", "date": "2021-10-25", "time": "14:30", "sender": "선우", "text": "너가 모르면 나도 몰라!", "trans": "你不知道的話，我也不知道！"},
    {"id": "msg0208", "date": "2021-10-25", "time": "14:30", "sender": "선우", "text": "물어봐야징", "trans": "得去問問才行"},
    {"id": "msg0209", "date": "2021-10-25", "time": "14:30", "sender": "선우", "text": "알려줘도 되면 알려주고 안되면 쩔 수 없고!", "trans": "能告訴你的話就告訴你，不行的話也沒辦法！"},
    {"id": "msg0210", "date": "2021-10-25", "time": "14:33", "sender": "선우", "text": "아직 안 물어봐뜸", "trans": "我還沒問啦"},
    {"id": "msg0211", "date": "2021-10-25", "time": "14:33", "sender": "선우", "text": "ㅋㅋㅋㅋㅋㅋ 꿀기", "trans": "哈哈哈哈哈，꿀기"},
