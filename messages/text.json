    {"id": "msg0214", "date": "2021-10-25", "time": "14:34", "sender": "선우", "text": "꿀기~~~~", "trans": "꿀기~~~~"},
    {"id": "msg0215", "date": "2021-10-25", "time": "14:35", "sender": "선우", "text": "과연", "trans": "究竟會是什麼呢"},
    {"id": "msg0216", "date": "2021-10-25", "time": "14:35", "sender": "선우", "text": "우리 컨셉 뭐 같음", "trans": "你覺得我們這次是什麼概念？"},
    {"id": "msg0217", "date": "2021-10-25", "time": "14:36", "sender": "선우", "text": "근데 반전이 있어", "trans": "不過有個反轉"},
    {"id": "msg0218", "date": "2021-10-25", "time": "14:36", "sender": "선우", "text": "첫번째 포토", "trans": "第一組照片"},
    {"id": "msg0219", "date": "2021-10-25", "time": "14:36", "sender": "선우", "text": "블룸블룸 2탄이야..", "trans": "是《Bloom Bloom》第二彈……"},
    {"id": "msg0220", "date": "2021-10-25", "time": "14:37", "sender": "선우", "text": "사실 우린 같은 반 친구들이고 같이 소풍가는 내용", "trans": "其實我們是同班同學，內容是一起去郊遊"},
    {"id": "msg0221", "date": "2021-10-25", "time": "14:38", "sender": "선우", "text": "청량임", "trans": "是清爽概念"},
    {"id": "msg0222", "date": "2021-10-25", "time": "14:38", "sender": "선우", "text": "ㅋㅋ 우정초그", "trans": "哈哈，友情小學，哈"},
    {"id": "msg0223", "date": "2021-10-25", "time": "14:40", "sender": "선우", "text": "초컷 ㅎㅋ", "trans": "是小學風照片，哈哈"},
    {"id": "msg0224", "date": "2021-10-25", "time": "14:40", "sender": "선우", "text": "초크가아니라", "trans": "不是「粉筆（chalk）」啦"},
    {"id": "msg0225", "date": "2021-10-25", "time": "14:40", "sender": "선우", "text": "당구 칠 뻔", "trans": "差點就要去打撞球了"},
    {"id": "msg0226", "date": "2021-10-25", "time": "14:41", "sender": "선우", "text": "ㅋㅋ 당구 좀 쳤지", "trans": "哈哈，我還滿會打撞球的"},
    {"id": "msg0227", "date": "2021-10-25", "time": "14:42", "sender": "선우", "text": "티저 사진", "trans": "預告照片"},
    {"id": "msg0228", "date": "2021-10-25", "time": "14:42", "sender": "선우", "text": "눈물이 똥그래", "trans": "眼淚圓滾滾的"},
    {"id": "msg0229", "date": "2021-10-25", "time": "14:42", "sender": "선우", "text": "진짜 눈물이지 당근", "trans": "當然是真眼淚啊"},
    {"id": "msg0230", "date": "2021-10-25", "time": "14:43", "sender": "선우", "text": "난 내가 이렇게 연기를 잘 하는지 처음 알았어", "trans": "我第一次知道原來自己這麼會演戲"},
    {"id": "msg0231", "date": "2021-10-25", "time": "14:44", "sender": "선우", "text": "슬픈 생각해써", "trans": "我想了悲傷的事情"},
    {"id": "msg0232", "date": "2021-10-25", "time": "14:44", "sender": "선우", "text": "눈물 흘리는 법을 알아냈음", "trans": "我發現流眼淚的方法了"},
    {"id": "msg0233", "date": "2021-10-25", "time": "14:45", "sender": "선우", "text": "사회생활에 가끔 이용해봐", "trans": "偶爾在社會生活中試著用用看"},
    {"id": "msg0234", "date": "2021-10-25", "time": "14:45", "sender": "선우", "text": "일단 우는 척을 내면으로 시작하셈 그 울 때 호흡있잖아", "trans": "首先從內心開始裝哭，你知道哭的時候那種呼吸吧"},
    {"id": "msg0235", "date": "2021-10-25", "time": "14:45", "sender": "선우", "text": "크흑..큽,,, 이런 호흡", "trans": "像「嗚呃……嗝……」這樣的呼吸"},
    {"id": "msg0236", "date": "2021-10-25", "time": "14:45", "sender": "선우", "text": "그걸 내면으로 시작하셈", "trans": "先從內在開始做出那種呼吸"},
    {"id": "msg0237", "date": "2021-10-25", "time": "14:46", "sender": "선우", "text": "그때 탄력을 받아서 슬픈 생각을 얹으셈", "trans": "接著順著那股勁，加上悲傷的想法"},
    {"id": "msg0238", "date": "2021-10-25", "time": "14:46", "sender": "선우", "text": "그담에 내면으로 그 상황에서 대사를 치셈", "trans": "然後在心裡說出符合那個情境的台詞"},
    {"id": "msg0239", "date": "2021-10-25", "time": "14:46", "sender": "선우", "text": "만약 슬픈 상황이면 그 상황에서 뭐 예를 들면 엄마 미안해,, 라던가", "trans": "假如是悲傷的情境，就在那個情境裡說些像「媽媽，對不起……」之類的話"},
    {"id": "msg0240", "date": "2021-10-25", "time": "14:46", "sender": "선우", "text": "ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ", "trans": "哈哈哈哈哈哈哈哈哈哈哈哈"},
    {"id": "msg0241", "date": "2021-10-25", "time": "14:47", "sender": "선우", "text": "그담 눈물이 고이는 것 까지 오면", "trans": "接著，等眼淚開始在眼眶裡打轉"},
    {"id": "msg0242", "date": "2021-10-25", "time": "14:47", "sender": "선우", "text": "여기가 고비임 눈물 고이는 건 누구나 다 함", "trans": "這裡才是難關，讓眼淚在眼眶裡打轉誰都做得到"},
    {"id": "msg0243", "date": "2021-10-25", "time": "14:47", "sender": "선우", "text": "그 다음에 눈물이 고였으면 중간에 현타를 막아야함", "trans": "接下來眼淚蓄起來後，要阻止自己中途突然清醒"},
    {"id": "msg0244", "date": "2021-10-25", "time": "14:47", "sender": "선우", "text": "내가 뭐하는 거제 이 생각을 막으셈", "trans": "要阻止自己產生「我到底在做什麼啊」的想法"},
    {"id": "msg0245", "date": "2021-10-25", "time": "14:48", "sender": "선우", "text": "그 담에 그냥 눈물 고였으면 이유도 없이 서럽다고 생각하고 살짝 숨을 코로 두어번 내뱉으면서 헝헝 울어보면", "trans": "然後眼淚蓄起來後，就想著自己莫名地很委屈，再用鼻子輕輕呼氣兩三次，試著嗚嗚地哭"},
    {"id": "msg0246", "date": "2021-10-25", "time": "14:48", "sender": "선우", "text": "내 뇌가 내 행동에 속아가지고 그냥 갑자기 억울하게 눈물나옴", "trans": "我的大腦會被自己的行為騙過去，突然就覺得很委屈，眼淚也跟著流出來"},
    {"id": "msg0247", "date": "2021-10-25", "time": "14:48", "sender": "선우", "text": "결론은 일단 우는 척으로 시작..", "trans": "結論就是，首先從假裝哭開始……"},
    {"id": "msg0248", "date": "2021-10-25", "time": "14:49", "sender": "선우", "text": "사회 생활에 어따 써먹을지는 모르겠지만", "trans": "雖然不知道在社會生活中能用在哪裡"},
    {"id": "msg0249", "date": "2021-10-25", "time": "14:49", "sender": "선우", "text": "눈물이 가끔 무기가 될 수도 있자나연", "trans": "但眼淚偶爾也可能成為武器嘛"},
    {"id": "msg0250", "date": "2021-10-25", "time": "14:49", "sender": "선우", "text": "물론 비추지만", "trans": "當然，我不推薦就是了"},
    {"id": "msg0251", "date": "2021-10-25", "time": "14:50", "sender": "선우", "text": "그런 상황이 안 오는게 베스트지 뭐 ^^*", "trans": "最好還是不要遇到那種情況啦^^*"},
    {"id": "msg0252", "date": "2021-10-25", "time": "14:51", "sender": "선우", "text": "자 이제 다들", "trans": "好了，現在大家"},
    {"id": "msg0253", "date": "2021-10-25", "time": "14:51", "sender": "선우", "text": "눈물 셀카 보내", "trans": "把流淚自拍傳來"},
    {"id": "msg0254", "date": "2021-10-25", "time": "14:51", "sender": "선우", "text": "난 공개적으로 올렸자나", "trans": "我都公開發上去了嘛"},
    {"id": "msg0255", "date": "2021-10-25", "time": "14:52", "sender": "선우", "text": "누가 살아남을까", "trans": "誰能活下來呢"},
    {"id": "msg0256", "date": "2021-10-25", "time": "14:53", "sender": "선우", "text": "내 눈빛이 어떤지 유추해바", "trans": "猜猜看我的眼神是在表達什麼"},
    {"id": "msg0257", "date": "2021-10-25", "time": "14:54", "sender": "선우", "text": "해석 맛집 더비", "trans": "最會解讀的THE B"},
    {"id": "msg0258", "date": "2021-10-25", "time": "14:54", "sender": "선우", "text": "로투킹과 킹덤으로 다져진", "trans": "經過《Road to Kingdom》和《Kingdom》鍛鍊出來的"},
    {"id": "msg0259", "date": "2021-10-25", "time": "14:55", "sender": "선우", "text": "난 사실 뭔가 새로운 거 해보고 싶어", "trans": "其實我想嘗試一些新的東西"},
    {"id": "msg0260", "date": "2021-10-25", "time": "14:55", "sender": "선우", "text": "40분짜리 뮤비라던가", "trans": "例如長達40分鐘的MV"},
    {"id": "msg0261", "date": "2021-10-25", "time": "14:55", "sender": "선우", "text": "단편영화처럼", "trans": "像短篇電影一樣"},
    {"id": "msg0262", "date": "2021-10-25", "time": "14:56", "sender": "선우", "text": "그 안에 단편적인 세계관이라도 좋으니", "trans": "即使裡面只有一個單篇式的世界觀也好"},
    {"id": "msg0263", "date": "2021-10-25", "time": "14:56", "sender": "선우", "text": "멤버들이랑 함 해보고 싶음", "trans": "想和成員們一起試著做一次"},
    {"id": "msg0264", "date": "2021-10-25", "time": "14:56", "sender": "선우", "text": "난 나 밖에 못봐서 몰랐는데 어제 뜬 거 보니까", "trans": "我之前只能看到自己，所以不知道，但看了昨天公開的內容後"},
    {"id": "msg0265", "date": "2021-10-25", "time": "14:56", "sender": "선우", "text": "멤버들 눈빛이 많이 농익었음", "trans": "成員們的眼神真的成熟了很多"},
    {"id": "msg0266", "date": "2021-10-25", "time": "14:57", "sender": "선우", "text": "ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ", "trans": "哈哈哈哈哈哈哈哈哈哈哈"},
    {"id": "msg0267", "date": "2021-10-25", "time": "14:57", "sender": "선우", "text": "그러니까 우리도 데뷔한지 오래는 안되었지만", "trans": "所以，雖然我們出道的時間還不算很久"},
    {"id": "msg0268", "date": "2021-10-25", "time": "14:57", "sender": "선우", "text": "쪼끔 해보니까", "trans": "但稍微演過一些之後"},
    {"id": "msg0269", "date": "2021-10-25", "time": "14:58", "sender": "선우", "text": "더캐슬의 명연기보다", "trans": "比起《The Castle》裡的精湛演技"},
    {"id": "msg0270", "date": "2021-10-25", "time": "14:58", "sender": "선우", "text": "더 잘할 수도 있다고 생각이 들더라고", "trans": "我覺得自己說不定還能演得更好"},
    {"id": "msg0271", "date": "2021-10-25", "time": "14:59", "sender": "선우", "text": "더캐슬을 모르는 더비도 있겠지만", "trans": "雖然可能也有不知道《The Castle》的THE B"},
    {"id": "msg0272", "date": "2021-10-25", "time": "14:59", "sender": "선우", "text": "그런게 있어.. 우리의 명작", "trans": "有那麼一部作品……是我們的名作"},
    {"id": "msg0273", "date": "2021-10-25", "time": "14:59", "sender": "선우", "text": "나의 손연기,,", "trans": "我的手部演技……"},
    {"id": "msg0274", "date": "2021-10-25", "time": "14:59", "sender": "선우", "text": "근데 어때 진짜", "trans": "不過說真的，怎麼樣？"},
    {"id": "msg0275", "date": "2021-10-25", "time": "14:59", "sender": "선우", "text": "40분 짜리 뮤비", "trans": "長達40分鐘的MV"},
